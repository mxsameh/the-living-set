{{ 's-header.css' | asset_url | stylesheet_tag }}
<script src="{{ 'j-header.js' | asset_url }}" defer="defer"></script>

<div class="h_">
  <div class="h-ph"></div>

  <header id="h" class="h">
    <!-- Header Left -->
    <div class="h_l">
      <a href="/">
        <img src="{{ 'im-emb-b.png' | asset_url  }}" width="auto" height="auto" alt="logo">
      </a>
      <a href="/" class="logo">
        <img src="{{ 'im-logo-b.png' | asset_url  }}" width="auto" height="auto" alt="logo">
      </a>
    </div>

    <!-- Header Right -->
    <div class="h_r">
      <nav class="h_n">
        {% for link in linklists['main-menu'].links -%}
          <div class="h_n-item">
            {{ link.title | link_to: link.url }}
          </div>
        {%- endfor %}
      </nav>

      <button id="cart-btn" class="h_cb" type="button">
        <div
          class="indi{% if cart.item_count == 0 %} d-n {% endif %}"
        ></div>
        <img src="{{ 'im-cart.png' | asset_url  }}" width="auto" height="auto" alt="logo">
      </button>
    </div>

    {% render 'menu-icon' %}
  </header>

  <div id="cart-btn" class="ccart">
    <div
      class="indi{% if cart.item_count == 0 %} d-n {% endif %}"
    ></div>
    <img src="{{ 'im-cart.png' | asset_url  }}" width="auto" height="auto" alt="logo">
  </div>

  <!-- MENU DRAWER -->
  {% render 'menu-drawer' %}
</div>

{% schema %}
{
  "name": "header",
  "settings": []
}
{% endschema %}
