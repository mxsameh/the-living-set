{{ 's-p-shop.css' | asset_url | stylesheet_tag }}
{{ 's-product-card.css' | asset_url | stylesheet_tag }}

{% liquid
  assign collection = collections.shop
%}

<div class="p">
  <div class="colc">
    <h1 class="d-o">
      A TABLE <br>
      IS NEVER <br>
      TRULY STILL
    </h1>
    <h1 class="m-o">
      A TABLE <br>
      IS NEVER TRULY STILL
    </h1>

    {% for product in collection.products %}
      {% render 'product-card', product: product %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "shop",
  "settings": []
}
{% endschema %}
