<a href="{{ product.url }}" class="pc">
  <figure>
    {{ product.featured_image | image_url: width: 800 | image_tag }}
  </figure>
  <div>
    <h3 class="{% unless price %}no-price{% endunless %} ">{{ product.title }}</h3>
    {% if price %}
      <p>
        {{ product.price | money_without_currency | remove: '.00' }}
        {{ shop.currency }}
      </p>
    {% endif %}
  </div>
</a>
